  isPlayer: 0
  playerID: -1
  speaker: {fileID: 0}
  messageText: "\u041F\u043E\u043C\u0438\u043C\u043E \u043A\u043D\u0438\u0433, \u043D\u0430
    \u043F\u043E\u043B\u043A\u0435 \u0433\u043E\u0440\u0434\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0441\u044F
    \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043F\u0440\u0438\u0447\u0443\u0434\u043B\u0438\u0432\u044B\u0439
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442.  \u0413\u0438\u043B\u044C\u0435\u0440\u043C\u043E
    \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B \u0435\u0433\u043E \u0432 \u043C\u0435\u0441\u0442\u043D\u043E\u0439
    \u043B\u0430\u0432\u043A\u0435 \u0432\u0441\u044F\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u044B\u0445 \u0431\u044B\u0442\u043E\u0432\u044B\u0445
    \u0432\u0435\u0449\u0435\u0439 \u0438 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u0445
    \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u043E\u0432. \u041E\u043D \u043D\u0435
    \u0437\u043D\u0430\u0435\u0442 \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F
    \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430."
