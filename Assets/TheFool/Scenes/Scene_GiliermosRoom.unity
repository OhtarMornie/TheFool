  speaker: {fileID: 0}
  messageText: "\u041D\u0430 \u043F\u043E\u043B\u043A\u0430\u0445 \u043F\u043B\u043E\u0442\u043D\u043E
    \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B \u043A\u043D\u0438\u0433\u0438
    \u043D\u0443\u0436\u043D\u043E\u0439 \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u044B. \u0422\u043E\u043B\u0441\u0442\u044B\u0435
    \u0443\u0432\u0435\u0441\u0438\u0441\u0442\u044B\u0435 \u0442\u043E\u043C\u0438\u043A\u0438
    \u0441\u0442\u043E\u044F\u0442 \u0434\u0440\u0443\u0433 \u043A \u0434\u0440\u0443\u0433\u0443
    \u0432\u043F\u043B\u043E\u0442\u043D\u0443\u044E \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E
    \u0445\u043E\u0442\u044F\u0442 \u0441\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F
    \u0434\u0440\u0443\u0433 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430 \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u043E\u0442 \u0413\u0438\u043B\u044C\u0435\u0440\u043C\u043E \u0438\u043C \u0442\u043E\u0447\u043D\u043E
    \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u0436\u0434\u0430\u0442\u044C."
