  parameterID: -1
  messageParameterID: -1
  isPlayer: 0
  playerID: -1
  speaker: {fileID: 0}
  messageText: "\u0420\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F
    \u0435\u0433\u043E, \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u0442\u044B
    \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
    \u0438\u043C\u043F\u0443\u043B\u044C\u0441 \u043F\u0440\u043E\u043A\u0440\u0443\u0442\u0438\u0442\u044C
    \u044D\u0442\u043E\u0442 \u0448\u0430\u0440, \u0442\u043A\u043D\u0443\u0442\u044C
    \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0435
    \u043C\u0435\u0441\u0442\u043E \u0438  \u0440\u0435\u0448\u0438\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0447\u0442\u043E-\u0442\u043E \u043D\u0435\u043E\u0431\u0434\u0443\u043C\u0430\u043D\u043D\u043E\u0435
    \u0438 \u0434\u043E\u0440\u043E\u0433\u043E\u0441\u0442\u043E\u044F\u0449\u0435\u0435,
    \u0447\u0442\u043E \u0441\u043C\u0435\u043D\u0438\u043B\u043E \u0431\u044B \u0442\u0432\u043E\u044E
    \u0440\u0443\u0442\u0438\u043D\u0443 \u0438 \u043E\u0441\u0432\u0435\u0436\u0438\u043B\u043E
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u043A \u0436\u0438\u0437\u043D\u0438,
    \u0430 \u043C\u043E\u0436\u0435\u0442, \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u043E\u0441\u044C
    \u0431\u044B \u043B\u0438\u0448\u044C \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u044B\u043C
    \u044D\u043F\u0438\u0437\u043E\u0434\u043E\u043C \u044D\u0441\u043A\u0430\u043F\u0438\u0437\u043C\u0430,
    \u0432\u0435\u0434\u044C \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C
    \u0432\u0441\u0435 \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u044F,
    \u043D\u0430\u0434\u0435\u044F\u0441\u044C \u043E\u0442\u0432\u043B\u0435\u0447\u044C\u0441\u044F
    \u043E\u0442 \u0441\u0432\u043E\u0438\u0445 \u043F\u0440\u043E\u0431\u043B\u0435\u043C,
    \u044D\u0442\u043E \u0432\u0441\u0435, \u0447\u0442\u043E \u0442\u044B \u0443\u043C\u0435\u0435\u0448\u044C."
